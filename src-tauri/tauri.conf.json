{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synoetis",
  "version": "1.0.0",
  "identifier": "com.synoetis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synoetis",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBQUU2RURENzIzOEFFOUMKUldTY3JqaHkzVzZ1S3ExajMzS1pmbWp1MGV2SXhEWk53L094QnA4UGM0ZTVRR09YQXRPOWE1bUsK",
      "endpoints": [
        "https://github.com/athulrajmp21/Synoetis/releases/latest/download/latest.json"
      ]
    }
  }
}
